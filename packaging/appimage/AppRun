#!/bin/sh
set -eu
app_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
case "${1:-}" in
    --install)
        shift
        exec "$app_dir/usr/libexec/ghm-appimage-install" "$@"
        ;;
    --cli) shift; executable=ghm ;;
    --worker) shift; executable=ghm-worker ;;
    --app-help)
        printf '%s\n' 'GitHub Commit Manager AppImage' \
            'No arguments: open the GTK application.' \
            '--cli COMMAND: run the native CLI (use --cli --help).' \
            '--worker: run the scheduling worker in the foreground.' \
            '--install: copy this AppImage to a stable user location, add a desktop entry and enable the user worker.'
        exit 0
        ;;
    *) executable=ghm-gui ;;
esac

# Use private GTK/GIO resources without contaminating host child programs with
# LD_LIBRARY_PATH. The binaries and modules have relative ELF RPATHs.
export GSETTINGS_SCHEMA_DIR="$app_dir/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$app_dir/usr/lib/gio/modules"
export XDG_DATA_DIRS="$app_dir/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GTK_PATH="$app_dir/usr/lib/gtk-4.0"
if [ -z "${FONTCONFIG_FILE:-}" ] && [ ! -r /etc/fonts/fonts.conf ]; then
    export FONTCONFIG_FILE="$app_dir/usr/share/fontconfig/fonts.conf"
fi
# Prefer the host's up-to-date certificate store; do not ship a stale CA bundle.
if [ -z "${SSL_CERT_FILE:-}" ]; then
    for certificate_file in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt /etc/ssl/ca-bundle.pem; do
        if [ -r "$certificate_file" ]; then
            export SSL_CERT_FILE="$certificate_file"
            break
        fi
    done
fi
if [ -n "${SSL_CERT_FILE:-}" ] && [ -z "${CURL_CA_BUNDLE:-}" ]; then
    export CURL_CA_BUNDLE="$SSL_CERT_FILE"
fi
if [ -z "${GHM_CA_BUNDLE:-}" ] && [ -n "${CURL_CA_BUNDLE:-}" ]; then
    export GHM_CA_BUNDLE="$CURL_CA_BUNDLE"
fi
if [ "$executable" != ghm-gui ]; then
    exec "$app_dir/usr/bin/$executable" "$@"
fi
export GSK_RENDERER="${GSK_RENDERER:-cairo}"

# Loader caches contain absolute paths. Build a private cache for this mount
# instead of referring to the build machine or racing another running image.
loader_cache=$(mktemp "${TMPDIR:-/tmp}/ghm-pixbuf-XXXXXX")
child_pid=
cleanup() { rm -f -- "$loader_cache"; }
terminate() {
    if [ -n "$child_pid" ]; then kill -TERM "$child_pid" 2>/dev/null || true; fi
}
trap cleanup EXIT
trap terminate HUP INT TERM
"$app_dir/usr/bin/gdk-pixbuf-query-loaders" "$app_dir"/usr/lib/gdk-pixbuf/loaders/*.so > "$loader_cache"
export GDK_PIXBUF_MODULE_FILE="$loader_cache"
"$app_dir/usr/bin/$executable" "$@" &
child_pid=$!
status=0
wait "$child_pid" || status=$?
# A trapped signal can interrupt wait before the child exits.
if kill -0 "$child_pid" 2>/dev/null; then wait "$child_pid" || status=$?; fi
exit "$status"
