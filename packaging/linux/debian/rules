#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON -DGHM_GITHUB_CLIENT_ID=@CLIENT_ID@ -DGHM_SYSTEMD_USER_UNIT_DIR=/usr/lib/systemd/user

# Scheduling is opt-in. Do not enable a worker for every user on installation.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

override_dh_auto_install:
	dh_auto_install
	desktop-file-validate debian/ghm/usr/share/applications/io.github.ghm.CommitManager.desktop
